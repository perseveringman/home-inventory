# ===== 后端访问鉴权（强烈推荐填）=====
# 客户端需要在请求头里带 Authorization: Bearer <这个 token>
# 生成方式：openssl rand -hex 32
AI_PROXY_TOKEN=

# ===== AI provider keys（按需填，留空则该 provider 关闭）=====
# MiniMax 国内 Token Plan（多模态主力）
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# OpenRouter（历史兼容 / 备选）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01

# DeepSeek（仅文本对话）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 可选 =====
# 把请求来源标识传给 OpenRouter（OpenRouter 用于面板归类）
# AI_HTTP_REFERER=https://homeapp.zyb.world
# AI_APP_TITLE=家居收纳

# CORS 白名单（逗号分隔），默认 * 放行所有
# 上线后建议收紧到 https://homeapp.zyb.world,capacitor://localhost
# ALLOWED_ORIGINS=*

# 监听端口（容器内，一般不用改；外部走 Caddy）
# PORT=8787
# HOST=0.0.0.0
